# Copy this file to .env for local development.
# On Vercel, set the same variables in Project Settings > Environment Variables.

# MongoDB Atlas connection string (Atlas > your cluster > Connect > Drivers).
MONGODB_URI=

# Database name inside the cluster (optional).
MONGODB_DB=roadmap_tracker

# Setup key for creating your account at /#/signup, and the secret that signs login cookies.
# Use a long, unique password.
ADMIN_PASSWORD=

# Optional: separate secret for signing login cookies. Defaults to ADMIN_PASSWORD.
SESSION_SECRET=

PORT=4321

# Optional: read-only test login made by `npm run test-account` (a member account).
# Leave TEST_PASSWORD empty and the script generates one and saves it here.
TEST_USERNAME=tester
TEST_PASSWORD=

# --- AI (interview scoring, AI answers, reading uploaded plans) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Google Calendar sync (see docs/implementation/calendar-integration.md) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://your-site.vercel.app/api/google/callback
# TOKEN_ENCRYPTION_KEY=

# Time zone for "today" and calendar times.
APP_TIMEZONE=Asia/Kolkata

# Sent by Vercel Cron to /api/cron/daily.
CRON_SECRET=

# Tests only: a throwaway MongoDB (its test database is dropped).
# TEST_MONGODB_URI=mongodb://127.0.0.1:27017
