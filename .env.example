# Copy this file to .env for local development.
# On Vercel, set the same variables in Project Settings > Environment Variables.

# MongoDB Atlas connection string (Atlas > your cluster > Connect > Drivers).
MONGODB_URI=

# Database name inside the cluster (optional).
MONGODB_DB=roadmap_tracker

# Password that unlocks editing. Anyone can view; only someone with this password can change things.
# Use a long, unique password.
ADMIN_PASSWORD=

# Optional: separate secret for signing login cookies. Defaults to ADMIN_PASSWORD.
SESSION_SECRET=

PORT=4321
