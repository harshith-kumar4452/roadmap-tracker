{
  "name": "roadmap-tracker",
  "version": "2.0.0",
  "private": true,
  "description": "Personal learning-roadmap tracker: Notion-style roadmap pages, progress, streaks. Express + MongoDB, deployable to Vercel.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --watch --env-file-if-exists=.env server.js",
    "seed": "node --env-file-if-exists=.env scripts/seed.mjs",
    "import:all": "node --env-file-if-exists=.env scripts/run-imports.mjs",
    "import:interview": "node --env-file-if-exists=.env scripts/import-interview-questions.mjs",
    "test-account": "node --env-file-if-exists=.env scripts/create-test-account.mjs",
    "interview:bank": "node --env-file-if-exists=.env scripts/build-interview-bank.mjs",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\""
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.0",
    "@mui/icons-material": "6.4.8",
    "@mui/material": "6.4.8",
    "exceljs": "4.4.0",
    "express": "5.1.0",
    "mammoth": "1.8.0",
    "mongodb": "^6.10.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "vite": "6.0.7"
  }
}
